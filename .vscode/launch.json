{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FactSheetAI: Launch Server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "factsheetai.api:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--reload"
      ],
      "jinja": true,
      "justMyCode": true,
      "python": "${workspaceFolder}/.venv/Scripts/python.exe"
    }
  ]
}
